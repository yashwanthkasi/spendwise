# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI parser — the app tries Gemini first, falls back to Groq, then to regex.
# Either/both/neither can be set; missing just means "skip that provider".

# Google Gemini (preferred)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Groq (fallback)
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile
